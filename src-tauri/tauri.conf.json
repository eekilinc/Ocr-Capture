{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metin Yakalayıcı",
  "version": "2.4.0",
  "identifier": "com.ekrem.metin-yakalayici",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metin Yakalayıcı",
        "width": 1220,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 Ekrem Kılınç",
    "shortDescription": "Ekran görüntülerinden hızlı ve çevrimdışı metin ayıklama aracı.",
    "longDescription": "Ekran görüntülerinden hızlı ve çevrimdışı metin ayıklama aracı.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Turkish"
        ],
        "installMode": "perMachine"
      }
    }
  }
}
